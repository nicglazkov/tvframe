<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Lets the home screen see which TV apps are installed (no QUERY_ALL_PACKAGES). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.google.android.apps.tv.launcherx" />
        <package android:name="com.android.tv.settings" />
        <!-- Google Sans comes from the Play services font provider -->
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:name=".TvFrameApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.TvFrame">

        <!-- The screensaver. Set it with:
             settings put secure screensaver_components app.tvframe/.FrameDreamService -->
        <service
            android:name=".FrameDreamService"
            android:exported="true"
            android:label="@string/dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/frame_dream" />
        </service>

        <!-- Home key: makes Quiet Home the home screen, Google TV home stays installed. -->
        <service
            android:name=".HomeKeyService"
            android:exported="false"
            android:label="@string/home_key_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_key" />
        </service>

        <!-- The frame on demand (star button, or the Photos tile). -->
        <activity
            android:name=".ShowActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TvFrame.Fullscreen" />

        <!-- E, the Quiet Home. -->
        <activity
            android:name=".QuietHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TvFrame.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings, also the app's own tile in any launcher. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".AppPickerActivity" android:exported="false" android:screenOrientation="landscape" />

        <!-- Runs the slideshow as a normal activity: preview, and for timing with am start -W. -->
        <activity
            android:name=".DreamPreviewActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TvFrame.Fullscreen" />

        <!-- Read-only device check: display modes, UI size, decoders, 4K test chart. -->
        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TvFrame.Fullscreen" />
    </application>
</manifest>
