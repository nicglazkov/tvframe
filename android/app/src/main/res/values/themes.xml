<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvFrame" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.TvFrame.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <style name="Theme.TvFrame.Home">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
