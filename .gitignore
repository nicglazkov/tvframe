# An allow-list: only code and docs are tracked. Photos, the library, generated media, scores, settings,
# logs, caches and the signing key all stay on the server.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/config.example.env
!/home_entities.example.json
!/docs/
!/deploy/
!/android/
!/server/
!/tools/
!/site/
!/caddy/
!/curate/
!/ingest/

/android/*
!/android/app/
!/android/gradle/
!/android/build.gradle.kts
!/android/settings.gradle.kts
!/android/gradle.properties
!/android/gradlew
!/android/gradlew.bat
!/android/tools/
/android/app/build/
/android/tools/gtv_audit.py
/android/tools/measure.sh

/server/*
!/server/*.py
!/server/compat8.sh

/site/*
!/site/index.html

/curate/*
!/curate/curate.py
!/curate/sampler.py
!/curate/preview.py
!/curate/run.sh
!/curate/Dockerfile

/ingest/*
!/ingest/gpalbum.py
!/ingest/sync.sh
!/ingest/README.md
!/ingest/albums.example.txt

/tools/*
!/tools/conf.sh
!/tools/package.json
!/tools/package-lock.json
!/tools/Dockerfile.media
!/tools/geo/
!/tools/screenshots/
!/tools/atvremote.py
!/tools/clip_look.py
!/tools/clip_loops.py
!/tools/clip_score.py
!/tools/curate_meta.py
!/tools/fetch_live.py
!/tools/ha_ws.py
