!/tools/watchdog.py
!/tools/deploy.sh
!/tools/rollback.sh
!/tools/keepmute.sh
!/tools/library_sync.sh
!/tools/real_build.sh
!/tools/fakekey.sh
!/tools/startdream.sh
/tools/geo/*.json

