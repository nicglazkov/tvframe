# TV Frame settings for one home. Copy to ~/.config/tvframe/config.env (chmod 600) and fill in.
# Read by server/tvconf.py (Python) and tools/conf.sh (shell). An environment variable of the same name wins.
# Everything is optional: leave a line out and the feature that needs it turns off.

# This server's LAN address, as the TV and your phone reach it (used in links to maps and thumbnails).
TVFRAME_HOST=192.168.1.20

# The TV's adb address (Developer options > Network debugging), for deploy.sh, rollback.sh and the watchdog.
TVFRAME_TV=192.168.1.30:5555

# Local time for schedules, logs and the Glance screen.
TVFRAME_TZ=America/New_York

# Online extras. Each is off unless its line says on, and while off TV Frame never contacts that service.
# Turning one on means accepting that service's terms. After a change: ./tvframe restart, and ./tvframe rebuild for places and maps.
TVFRAME_WEATHER=off     # weather and air quality on Glance, from Open-Meteo (sends LIVE_LAT/LIVE_LON)
TVFRAME_HEADLINES=off   # the headline tile, from NPR's top stories feed (sends nothing)
TVFRAME_PLACES=off      # place names for photos with a location, from OpenStreetMap (sends each location, rounded)
TVFRAME_MAPS=off        # satellite maps in the details panel, from Esri World Imagery (sends the area around each photo)

# Where you are: sun times and golden hour (worked out here), and the weather when it is on. Shown as the place name.
LIVE_LAT=40.7128
LIVE_LON=-74.0060
LIVE_PLACE="New York"

# "Around home" grouping: photos further than ~40 km from here count as trips. Defaults to LIVE_LAT/LIVE_LON.
# HOME_LAT=40.7128
# HOME_LON=-74.0060

# Home Assistant (optional): the Home tile on Glance, now-playing music on the home screen, watchdog notices.
HA_URL=http://homeassistant.local:8123
# A long-lived access token, alone in this file, chmod 600.
HA_TOKEN_FILE=~/.config/tvframe/ha_token
# Which entity plays each part of the Home tile (see home_entities.example.json).
HA_ENTITIES=~/.config/tvframe/home_entities.json
# The TV's media_player, for tools/keepmute.sh.
HA_TV_PLAYER=media_player.living_room_tv
# Where the watchdog sends its plain notifications.
HA_NOTIFY=notify.mobile_app_phone

# Optional fixed id prefixes for folders that must keep older photo ids (JSON).
# TVFRAME_ALBUM_PREFIXES='{"Summer 2024": "s"}'
# Clip ids whose rotation tag is wrong and should be ignored (JSON list).
# TVFRAME_NO_ROTATE='["trips-img-1234"]'
